# Gemini API configuration
GEMINI_API_KEY="replace-with-runtime-secret"

# Public application URL
APP_URL="https://replace-with-app-url.example"

# Bible365 Apps Script runtime configuration
# Store real values in Vercel Environment Variables or another secret store.
# Never commit live tokens, deployment secrets, refresh tokens, or private keys.
BIBLE365_GAS_WEBAPP_URL="https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec"
BIBLE365_ACCESS_TOKEN="replace-with-rotated-token"

# Browser-exposed variables must not contain a private token.
VITE_BIBLE365_ENGINE_URL=""
VITE_BIBLE365_SPREADSHEET_ID=""

PORT=3000
