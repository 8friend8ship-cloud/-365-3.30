# Bible365 canonical runtime is backdata-first and does not require Gemini in the browser.
# Keep secrets server-side only. Never use a VITE_ prefix for credentials.

# APP_URL: hosting origin used for callbacks/self links when needed.
APP_URL="MY_APP_URL"

# Server-only Apps Script access token used by the proxy layer.
# Configure in the server/hosting secret store. Do not commit a real value.
BIBLE365_ACCESS_TOKEN=""

# AUDIO_WEBAPP_BASE_URL: optional GAS WebApp override for server-side audio fetching.
# Example: https://script.google.com/macros/s/NEW_DEPLOYMENT_ID/exec
AUDIO_WEBAPP_BASE_URL=""
