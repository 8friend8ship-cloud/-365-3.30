# Bible365 canonical runtime is backdata-first and uses the existing Bible1 Apps Script chain.
# All ids/credentials stay server-side. Never use a VITE_ prefix for credentials or Apps Script ids.

APP_URL="MY_APP_URL"

# Canonical Bible1 Apps Script engine WebApp. Existing deployment only; do not create a replacement by default.
BIBLE365_ENGINE_WEBAPP_URL=""

# Optional dedicated audio-delivery WebApp. Leave empty to reuse BIBLE365_ENGINE_WEBAPP_URL.
BIBLE365_DELIVERY_WEBAPP_URL=""

# Existing server-side access token. Store in the hosting secret manager.
BIBLE365_ACCESS_TOKEN=""

# Canonical Bible365 spreadsheet id (1.잠언 365: AI 지혜의 등불). Server-side only.
BIBLE365_SPREADSHEET_ID=""

# Optional existing editor id if the Apps Script contract still requires it. Server-side only.
BIBLE365_EDITOR_ID=""
